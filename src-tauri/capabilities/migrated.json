{
  "identifier": "migrated",
  "description": "从v1迁移的权限。",
  "local": true,
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "updater:default",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "opener:allow-default-urls",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1:*/" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost" },
        { "url": "http://localhost:*/" },
        { "url": "http://localhost:*/*" }
      ]
    },
    "notification:default"
  ]
}